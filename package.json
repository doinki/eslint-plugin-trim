{
  "name": "eslint-plugin-trim",
  "version": "1.0.2",
  "keywords": [
    "eslint",
    "react",
    "trim"
  ],
  "homepage": "https://github.com/doinki/eslint-plugin-trim#readme",
  "bugs": "https://github.com/doinki/eslint-plugin-trim/issues",
  "license": "MIT",
  "author": {
    "name": "doinki",
    "email": "doinki94@gmail.com",
    "url": "https://github.com/doinki"
  },
  "repository": {
    "url": "git+https://github.com/doinki/eslint-plugin-trim.git"
  },
  "files": [
    "dist"
  ],
  "type": "commonjs",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "tsx test/argument.test.ts && tsx test/class-name.test.ts",
    "release": "pnpm run build && publint && changeset publish",
    "fmt": "oxfmt",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/eslint": "^9.6.1",
    "@types/estree": "^1.0.9",
    "eslint": "^10.13.0",
    "oxfmt": "^0.74.0",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": ">=3",
    "eslint": ">=6"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=14"
  },
  "packageManager": "pnpm@12.14.0"
}
